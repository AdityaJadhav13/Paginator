{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/*"
    },
    {
      "Sid": "DeleteUploadsOnly",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/uploads/*"
    },
    {
      "Sid": "WorkBucketListAndVersioning",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}"
    }
  ]
}
