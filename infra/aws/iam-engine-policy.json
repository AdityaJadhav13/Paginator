{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkBucketOrganisationsReadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*"
    },
    {
      "Sid": "WorkBucketRenditionsWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*/pubs/*/assets/*/r/*"
    },
    {
      "Sid": "WorkBucketImportResultsWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*/pubs/*/imports/*/result-*.json"
    },
    {
      "Sid": "WorkBucketEngineProfileConfigWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*/pubs/*/profiles/*/config.json"
    },
    {
      "Sid": "WorkBucketRunPagesWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*/pubs/*/runs/*/pages/*"
    },
    {
      "Sid": "WorkBucketRunEditionPdfWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*/pubs/*/runs/*/edition.pdf"
    },
    {
      "Sid": "WorkBucketRunPressZipWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::${PGN_S3_WORK_BUCKET}/orgs/*/pubs/*/runs/*/press-files.zip"
    }
  ]
}
