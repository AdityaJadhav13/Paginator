{
  "name": "pageinator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ci": "pnpm run guard && pnpm run check:graph && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm --filter @pageinator/web build",
    "guard": "node tools/ts/guard-private.ts && node tools/ts/check-frozen.ts",
    "check:graph": "node tools/ts/check-graph.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && pnpm --filter @pageinator/web typecheck",
    "test": "vitest run",
    "test:private": "PAGEINATOR_PRIVATE_RUN=1 vitest run --project private",
    "check:oracle": "node tools/ts/check-oracle-manifest.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/js": "catalog:",
    "@typescript/native": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
