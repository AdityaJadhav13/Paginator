# Development settings for the local services (infra/docker/compose.dev.yml); every pnpm dev:* script (up, down and
# reset) passes this file to docker compose. Copy it to .env.dev (git-ignored) and replace every placeholder with your
# own value; compose refuses to run while one is missing or empty. The database passwords are set on the first start
# only: after changing one, run `pnpm dev:reset` (it deletes this project's local development data).

# The Postgres superuser (postgres). With this password it can also sign in from this machine over TCP
# (127.0.0.1:55432), so treat it like the other secrets here.
PGN_POSTGRES_PASSWORD=dev-placeholder-superuser

# Login roles: docs/product/10-l2-newsroom-plan.md §3.1, and pgn_listen from ADR-025 and plan §10 row 5. The API reads
# the app, auth and listen passwords too (pnpm --filter @pageinator/api dev), the migration command the migrator's, and
# the database tests all of them, the superuser's included (pnpm run test:db).
PGN_MIGRATOR_PASSWORD=dev-placeholder-migrator
PGN_APP_PASSWORD=dev-placeholder-app
PGN_AUTH_PASSWORD=dev-placeholder-auth
PGN_ENGINE_PASSWORD=dev-placeholder-engine
PGN_LISTEN_PASSWORD=dev-placeholder-listen

# The API's sign-in secret (Better Auth): it signs sessions and emailed tokens; at least 32 characters
PGN_AUTH_SECRET=dev-placeholder-sign-in-secret-of-32-characters-or-more

# SeaweedFS S3: the only key pair it accepts (unsigned requests are refused)
PGN_S3_ACCESS_KEY_ID=dev-placeholder-s3-key
PGN_S3_SECRET_ACCESS_KEY=dev-placeholder-s3-secret
