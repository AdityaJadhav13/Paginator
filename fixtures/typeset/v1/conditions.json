{
  "schema": "pageinator.corpus.conditions/1",
  "version": "1.0.0",
  "notes": "Layout conditions for Phase 0. Column widths and sizes are PLAUSIBLE broadsheet values, NOT pilot values. 30.25 mm comes from the old spec ((318 - 2*24 - 7*4)/8). Replace with the pilot's grid after G0 (questionnaire 17 §C6 and P0-03).",
  "body_fonts": {
    "Deva": [{"family": "Noto Serif Devanagari", "weight": 400}, {"family": "Mukta", "weight": 400},
