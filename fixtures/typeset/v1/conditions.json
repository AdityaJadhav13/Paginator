    "mixed": {"widths_mm": [45.0], "size_pt": 10.0, "policy": "P0_oracle_default", "algorithm": "knuth_plass",
              "fonts": {"Deva": ["Noto Serif Devanagari", "Mukta"], "Latn": ["Source Serif 4"]}}
  }
}
