    "P2_loose": {"word_space_min": 0.75, "word_space_max": 2.00, "tolerance": 1.0, "basis": "sensitivity probe"},
    "P3_very_loose": {"word_space_min": 0.70, "word_space_max": 3.00, "tolerance": 1.0,
                      "basis": "sensitivity probe; NOT an acceptable newspaper policy without review"}
  },
  "golden_matrix": {
    "body": {"widths_mm": [30.25, 45.0, 60.0], "size_pt": 9.5, "policy": "P0_oracle_default",
             "algorithm": "knuth_plass",
             "fonts": {"Deva": ["Noto Serif Devanagari", "Mukta"], "Latn": ["Source Serif 4"]}},
    "headline": {"widths_mm": [64.0, 132.0], "size_pt": 36, "policy": "P0_oracle_default", "algorithm": "greedy",
