    "Latn": [{"family": "Source Serif 4", "weight": 400}]
  },
  "headline_fonts": {
    "Deva": [{"family": "Noto Sans Devanagari", "weight": 700}, {"family": "Mukta", "weight": 700}],
    "Latn": [{"family": "Archivo Narrow", "weight": 700}]
