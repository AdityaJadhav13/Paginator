    "fastify-type-provider-zod": "catalog:",
    "kysely": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fastify/swagger": "catalog:",
    "@types/node": "catalog:",
